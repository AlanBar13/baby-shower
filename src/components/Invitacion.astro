<script is:inline>
/* Datos que se pueden cambiar */
var CONFIG = {
  whatsapp: { dafne: "524423602996", alan: "524423977484" }   // números con lada de país, solo dígitos (ej. 52XXXXXXXXXX)
};
var EVENT_TS = Date.UTC(2026, 10, 14, 20, 0, 0); // 14 nov 2026, 2:00 p.m. hora de CDMX (UTC-6)

(function () {
  var $ = function (id) { return document.getElementById(id); };

  /* Ajusta cada línea de texto al ancho del diseño original */
  var groups = {};
  function fit() {
    document.querySelectorAll('[data-fit]').forEach(function (el) {
      var cq = el.closest('.cq'); if (!cq) return;
      var unit = cq.clientWidth / 100; if (!unit) return;
      var w = el.getBoundingClientRect().width; if (!w) return;
      var cur = parseFloat(getComputedStyle(el).fontSize) / unit;
      var fs = cur * (parseFloat(el.dataset.fit) * unit) / w;
      el.style.fontSize = fs.toFixed(3) + 'cqw';
      if (el.dataset.group) groups[el.dataset.group] = fs;
    });
    Object.keys(groups).forEach(function (g) {
      document.documentElement.style.setProperty('--fs-' + g, groups[g].toFixed(3) + 'cqw');
    });
  }
  fit();
  window.addEventListener('load', fit);
  if (document.fonts) {
    if (document.fonts.ready) document.fonts.ready.then(fit);
    if (document.fonts.addEventListener) document.fonts.addEventListener('loadingdone', fit);
  }

  /* Entrada suave de cada hoja */
  var arts = document.querySelectorAll('.cq');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { threshold: 0.2, rootMargin: '0px 0px -6% 0px' });
    arts.forEach(function (a) { io.observe(a); });
  } else {
    arts.forEach(function (a) { a.classList.add('in'); });
  }
  requestAnimationFrame(function () { arts[0].classList.add('in'); });

  /* Cuenta regresiva en vivo */
  var cd = { d: $('cdD'), h: $('cdH'), m: $('cdM'), s: $('cdS'), head: $('cdHead') };
  function pad(n) { return n < 10 ? '0' + n : String(n); }
  function tick() {
    var diff = EVENT_TS - Date.now();
    if (diff <= 0) {
      var sinceMs = -diff;
      cd.d.textContent = '00'; cd.h.textContent = '00'; cd.m.textContent = '00'; cd.s.textContent = '00';
      cd.head.innerHTML = sinceMs < 6 * 3600 * 1000 ? '¡Hoy es el gran día!<br>Axel Damián ya viene' : 'Gracias por acompañarnos<br>a recibir a Axel Damián';
      return;
    }
    var s = Math.floor(diff / 1000);
    cd.d.textContent = pad(Math.floor(s / 86400));
    cd.h.textContent = pad(Math.floor(s % 86400 / 3600));
    cd.m.textContent = pad(Math.floor(s % 3600 / 60));
    cd.s.textContent = pad(s % 60);
  }
  tick();
  setInterval(tick, 1000);

  /* Copiar con respaldo */
  function copyText(text, fallbackEl, btn) {
    var label = btn.textContent;
    function ok() { btn.textContent = 'Copiado'; setTimeout(function () { btn.textContent = label; }, 1800); }
    function fallback() {
      try {
        var el = fallbackEl;
        if (!el) { el = document.createElement('textarea'); el.value = text; el.setAttribute('readonly', ''); el.style.cssText = 'position:fixed;left:-9999px'; document.body.appendChild(el); }
        el.focus(); el.select(); if (document.execCommand('copy')) ok();
        if (!fallbackEl) el.remove();
      } catch (e) {}
    }
    try { navigator.clipboard.writeText(text).then(ok, fallback); } catch (e) { fallback(); }
  }

  /* Confirmación de asistencia */
  var form = $('rsvp'), done = $('done'), preview = $('preview'), sub = $('submitBtn'), wa = document.querySelectorAll('.wa');
  function asiste() { return form.elements['asiste'].value; }
  var pf = $('personasField'); // no existe en la invitación personal
  var acomps = [].slice.call(document.querySelectorAll('.acomp'));
  function sync() {
    if (!pf) return;
    pf.hidden = asiste() === 'no';
    var n = parseInt($('personas').value, 10);
    acomps.forEach(function (a, i) { a.hidden = i >= n - 1; });
  }
  form.addEventListener('change', sync);
  sync();
  function fail(el, text) { $('err').textContent = text; $('err').hidden = false; el.focus(); }
  function prepare(ev) {
    if (ev) ev.preventDefault();
    var nombre = $('nombre').value.trim();
    if (!nombre) return fail($('nombre'), 'Escribe tu nombre para continuar.');
    var n = pf ? parseInt($('personas').value, 10) : 1, msg = $('mensaje').value.trim(), t, nombres = [];
    if (asiste() === 'si') {
      for (var i = 0; i < n - 1; i++) {
        var inp = acomps[i].querySelector('input'), v = inp.value.trim();
        if (!v) return fail(inp, 'Escribe el nombre de cada acompañante.');
        nombres.push(v);
      }
    }
    $('err').hidden = true;
    if (asiste() === 'si') {
      t = '¡Hola! Soy ' + nombre + '. Confirmo mi asistencia al baby shower de Axel Damián el sábado 14 de noviembre a las 2:00 p.m. para ' + n + (n === 1 ? ' persona.' : ' personas.');
      if (nombres.length) t += ' Me acompaña' + (nombres.length > 1 ? 'n: ' : ': ') + nombres.join(', ') + '.';
    } else {
      t = '¡Hola! Soy ' + nombre + '. Gracias por la invitación al baby shower de Axel Damián. Lamentablemente no podré asistir, pero les mando un abrazo.';
    }
    if (msg) t += ' ' + msg;
    preview.value = t;
    wa.forEach(function (a) { a.href = 'https://wa.me/' + CONFIG.whatsapp[a.dataset.to] + '?text=' + encodeURIComponent(t); a.hidden = false; });
    $('doneNote').textContent = 'Toca el botón de Alan o Dafne y se abre WhatsApp con tu mensaje listo.';
    form.hidden = true; done.hidden = false; sub.hidden = true;
  }
  form.addEventListener('submit', prepare);
  $('copyBtn').addEventListener('click', function () { copyText(preview.value, preview, this); });
  $('editBtn').addEventListener('click', function () { done.hidden = true; form.hidden = false; wa.forEach(function (a) { a.hidden = true; }); sub.hidden = false; });
})();
</script>
