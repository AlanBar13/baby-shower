---
const { pases } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Baby Shower de Axel Damián</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Raleway:wght@500;600;700&display=swap">
<style is:global>
/* Concepto: la invitación de Canva (6 hojas verticales) apilada en un scroll normal.
   Cada hoja es un lienzo escalable (unidades cqw) con las ilustraciones originales; el texto es real. */
:root {
  --crema: #FFFCF3;
  --pagina: #E4ECF1;
  --cafe: #8f6a41;
  --cafe-oscuro: #5e4b37;
  --azul: #6586a3;
  --azul-claro: #98bad9;
  --salvia: #8b987c;
  --verde-btn: #A9B78C;
  --f-serif: 'Fraunces', 'Iowan Old Style', Georgia, serif;
  --f-sans: 'Raleway', 'Avenir Next', 'Segoe UI', system-ui, sans-serif;
  --s: 1.7778; /* alto de la hoja = 177.78 cqw */
}
html { color-scheme: light; scroll-behavior: smooth; }
body { background: var(--pagina); color: var(--cafe-oscuro); font-family: var(--f-sans); -webkit-text-size-adjust: 100%; }
* { box-sizing: border-box; }
h1, h2, p { margin: 0; }
h1, h2 { font: inherit; display: contents; }
img { max-width: none; }
[hidden] { display: none !important; }

main { max-width: 560px; margin: 0 auto; background: var(--crema); box-shadow: 0 0 40px rgba(60, 90, 120, .12); }
.cq { container-type: inline-size; position: relative; width: 100%; overflow: hidden; }
.cq + .cq { margin-top: -6%; }
.art { position: relative; width: 100%; height: calc(177.7778cqw + var(--E, 0) * 1cqw); overflow: hidden;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 7cqw, #000 calc(100% - 7cqw), transparent 100%);
          mask-image: linear-gradient(to bottom, transparent 0, #000 7cqw, #000 calc(100% - 7cqw), transparent 100%); }
#portada .art { -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 7cqw), transparent 100%); mask-image: linear-gradient(to bottom, #000 calc(100% - 7cqw), transparent 100%); }
#gracias .art { -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 7cqw); mask-image: linear-gradient(to bottom, transparent 0, #000 7cqw); }

/* Imagenes del diseno */
.i { position: absolute; left: calc(var(--x) * 1cqw); top: calc(var(--y) * 1.7778cqw); width: calc(var(--w) * 1cqw); height: auto; pointer-events: none; user-select: none; -webkit-user-drag: none; }
.i.bot { top: auto; bottom: calc(var(--b) * 1cqw); }
.i.bg { left: 0; width: 100%; }
.i.fillh { height: 100%; object-fit: cover; top: 0; }
.i.cardimg { height: calc(var(--hh) * 1cqw); object-fit: fill; }

/* Texto */
.t { position: absolute; top: calc(var(--by) * 1cqw - .86em); left: calc(var(--cx) * 1cqw); transform: translateX(-50%); white-space: nowrap; line-height: 1; font-size: calc(var(--w) * 1cqw / var(--c) / .52); }
.t.l { left: calc(var(--lx) * 1cqw); transform: none; }
.serif { font-family: var(--f-serif); font-weight: 400; }
.sans { font-family: var(--f-sans); font-weight: 500; }
.sans.semi { font-weight: 600; }
.disp { font-optical-sizing: none; font-variation-settings: 'opsz' 60; }
.u-row { font-size: var(--fs-row, 3.5cqw); }
.u-addr { font-size: var(--fs-addr, 3.4cqw); }
.mapline { font-size: 4.2cqw; }

/* Datos: boton de mapa */
.pill { position: absolute; left: 24cqw; top: 138.6cqw; width: 38cqw; height: 10.8cqw; display: flex; align-items: center; justify-content: center; gap: 1.8cqw;
  background: url(/img/p2-67.webp) 0 0 / 100% 100% no-repeat; color: #5a6f87; text-decoration: none; font: 700 3.7cqw/1 var(--f-sans); transition: filter .2s; }
.pill img { width: 4.8cqw; height: auto; }
.pill:hover { filter: brightness(.96); }

/* Cuenta regresiva */
.cd { position: absolute; left: 19cqw; width: 62cqw; top: 59cqw; text-align: center; }
.cd-h { font: 400 5cqw/1.25 var(--f-serif); color: var(--cafe); }
.cd-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2cqw; margin-top: 7cqw; }
.cd-c { background: rgba(255, 255, 255, .72); border: .35cqw solid #cfdde9; border-radius: 3.2cqw; padding: 2.4cqw 0 2cqw; display: flex; flex-direction: column; align-items: center; gap: .8cqw; box-shadow: 0 .8cqw 2cqw rgba(101, 134, 163, .12); }
.cd-c b { font: 500 8.4cqw/1 var(--f-serif); color: var(--cafe); font-variant-numeric: tabular-nums; font-optical-sizing: none; font-variation-settings: 'opsz' 40; }
.cd-c small { font: 600 3cqw/1 var(--f-sans); color: var(--azul); letter-spacing: .04em; }
.cd-f { margin-top: 6.5cqw; font: 600 3.4cqw/1.3 var(--f-sans); color: #6f8ca6; }

/* Regalos */
.gbox { position: absolute; left: 12.43cqw; width: 75.09cqw; top: calc(var(--y) * 1.7778cqw); height: 31.75cqw; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5cqw; text-align: center; }
.g-l { font: 600 3.4cqw/1.2 var(--f-sans); color: #4f6474; }
.g-code { font: 500 10.5cqw/1 var(--f-serif); color: #a26e33; letter-spacing: .1em; padding-left: .1em; font-variant-numeric: tabular-nums; font-optical-sizing: none; font-variation-settings: 'opsz' 40; }
.g-name { font: 500 6cqw/1.1 var(--f-serif); color: #a26e33; font-optical-sizing: none; font-variation-settings: 'opsz' 40; }
.g-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 7.6cqw; padding: 0 5cqw; border-radius: 99cqw; border: 0; background: var(--azul); color: #fff; font: 700 3.5cqw/1 var(--f-sans); text-decoration: none; cursor: pointer; transition: transform .2s, filter .2s; }
.g-btn.big { min-height: 10.4cqw; padding: 0 9cqw; font-size: 4.2cqw; white-space: nowrap; }
.g-btn:hover { transform: translateY(-.3cqw); filter: brightness(1.06); }

/* Confirmacion */
.panel { position: absolute; left: calc(var(--x) * 1cqw); top: calc(var(--y) * 1.7778cqw); width: calc(var(--w) * 1cqw); min-height: calc(var(--hh) * 1cqw); padding: 4.2cqw 4.4cqw;
  background: linear-gradient(#f0f5fb, #e8eff8); border-radius: 5cqw; outline: .35cqw dashed #b4c8de; outline-offset: -1.7cqw; box-shadow: 0 1.2cqw 3cqw rgba(101, 134, 163, .16); z-index: 3; }
.pase { text-align: center; font: 600 3.6cqw/1.2 var(--f-sans); color: #a26e33; margin: 0 0 3cqw; }
.panel .f { display: block; font: 700 3.3cqw/1.2 var(--f-sans); color: #4f6474; margin: 2.4cqw 0 1cqw; }
.panel input[type=text], .panel select, .panel textarea { width: 100%; font: 600 max(16px, 3.8cqw)/1.3 var(--f-sans); color: var(--cafe-oscuro); background: #fff; border: .35cqw solid #c9d8e8; border-radius: 3cqw; padding: 2.2cqw 3cqw; }
.panel textarea { resize: none; display: block; }
.panel input::placeholder, .panel textarea::placeholder { color: #9aa9b8; }
.choice { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2.4cqw; }
.chip { display: block; position: relative; }
.chip input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.chip span { display: block; text-align: center; padding: 3cqw 1cqw; border-radius: 3cqw; background: #fff; border: .35cqw solid #c9d8e8; font: 700 3.5cqw/1.1 var(--f-sans); color: #4f6474; }
.chip input:checked + span { background: var(--azul); border-color: var(--azul); color: #fff; }
.chip input:focus-visible + span, .panel input:focus-visible, .panel select:focus-visible, .panel textarea:focus-visible, .gbtn:focus-visible, .g-btn:focus-visible, .pill:focus-visible, .lnk:focus-visible {
  outline: .8cqw solid #e2a35f; outline-offset: .4cqw; }
.err { color: #9a3b26; font: 700 3.2cqw/1.2 var(--f-sans); margin-top: 2cqw; }
.note { font: 600 3.1cqw/1.3 var(--f-sans); color: #4f6474; margin-top: 2cqw; }
#done .g-btn { margin-top: 2.6cqw; }
#preview { font-size: max(16px, 3.4cqw); line-height: 1.3; }
.lnk { background: none; border: 0; padding: 1.5cqw 0 0; font: 700 3.3cqw var(--f-sans); color: var(--azul); text-decoration: underline; cursor: pointer; display: block; }
.gbtn { position: absolute; left: calc(var(--x) * 1cqw); bottom: calc(var(--b) * 1cqw); width: calc(var(--w) * 1cqw); height: 15cqw; display: flex; align-items: center; justify-content: center; text-align: center;
  background: url(/img/p5-117.webp) 0 0 / 100% 100% no-repeat; border: 0; padding: 0; color: #fff; font: 700 4.4cqw/1 var(--f-sans); text-decoration: none; cursor: pointer; z-index: 3; transition: filter .2s; text-shadow: 0 .2cqw .6cqw rgba(70, 85, 55, .35); }
.gbtn:hover { filter: brightness(.97) saturate(1.05); }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Movimiento: cada parte aparece al llegar con el scroll */
.anim .rise { opacity: 0; translate: 0 2.6cqw; transition: opacity .9s ease, translate 1s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--d, 0) * 120ms); }
.anim .in .rise { opacity: 1; translate: 0 0; }
.anim .fx { opacity: 0; transition: opacity 1s ease, translate 1.1s cubic-bezier(.2, .7, .2, 1), scale 1.1s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--d, 0) * 110ms); }
.anim .fx-up { translate: 0 4cqw; }
.anim .fx-drop { translate: 0 -6cqw; }
.anim .fx-l { translate: -9cqw 0; }
.anim .fx-r { translate: 9cqw 0; }
.anim .fx-zoom { scale: .955; }
.anim .fx-pop { translate: 0 7cqw; scale: .86; transition-duration: 1.2s; }
.anim .in .fx { opacity: 1; translate: 0 0; scale: 1; }
.float { animation: bob 6s ease-in-out infinite; }
.float.sway { animation: sway 7s ease-in-out infinite; transform-origin: 50% 70%; }
.tw { animation: tw 4.5s ease-in-out infinite; }
.tw:nth-of-type(odd) { animation-delay: -1.8s; }
.tw:nth-of-type(3n) { animation-delay: -3.1s; }
@keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-1.1cqw); } }
@keyframes sway { 0%, 100% { transform: rotate(-1.4deg); } 50% { transform: rotate(1.4deg) translateY(-.6cqw); } }
@keyframes tw { 0%, 100% { transform: scale(.92) rotate(-3deg); } 50% { transform: scale(1.1) rotate(3deg); } }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .float, .tw { animation: none; }
}
</style>
<script is:inline>if ("IntersectionObserver" in window && !(window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches)) document.documentElement.classList.add("anim");</script>
</head>
