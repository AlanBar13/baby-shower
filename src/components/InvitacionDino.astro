</div></div></section><section class="cq" id="regalos"><div class="art flow"><img class="i fx fx-drop  " style="--x:0.000;--w:100.000;--y:0.000;--d:0" src="/dino/img/a1.webp" alt="" width="1194" height="504" loading="lazy" decoding="async"><img class="i fx fx-l  " style="--x:0.000;--w:18.509;--y:37.102;--d:1" src="/dino/img/a6.webp" alt="" width="221" height="173" loading="lazy" decoding="async"><img class="i bot fx fx-l  " style="--x:0.000;--w:6.030;--b:60.972;--d:1" src="/dino/img/a37.webp" alt="" width="72" height="111" loading="lazy" decoding="async"><img class="i bot fx fx-l  " style="--x:0.000;--w:10.888;--b:47.320;--d:2" src="/dino/img/a48.webp" alt="" width="130" height="177" loading="lazy" decoding="async"><img class="i bot fx fx-r  " style="--x:83.501;--w:3.518;--b:44.389;--d:2" src="/dino/img/a71.webp" alt="" width="42" height="71" loading="lazy" decoding="async"><img class="i bot fx fx-l  " style="--x:0.000;--w:11.390;--b:26.214;--d:3" src="/dino/img/a76.webp" alt="" width="136" height="238" loading="lazy" decoding="async"><img class="i bot fx fx-l  " style="--x:12.982;--w:5.109;--b:40.704;--d:3" src="/dino/img/a78.webp" alt="" width="61" height="60" loading="lazy" decoding="async"><img class="i bot fx fx-up  " style="--x:65.578;--w:13.987;--b:0.000;--d:4" src="/dino/img/a87.webp" alt="" width="167" height="184" loading="lazy" decoding="async"><img class="i bot fx fx-up  " style="--x:32.663;--w:40.034;--b:0.000;--d:4" src="/dino/img/a88.webp" alt="" width="478" height="175" loading="lazy" decoding="async"><img class="i bot fx fx-up  " style="--x:25.963;--w:9.045;--b:0.000;--d:5" src="/dino/img/a89.webp" alt="" width="108" height="154" loading="lazy" decoding="async">
<div class="content">
  <h2 class="script rise" style="--d:1">Mesa de regalos</h2>
  <p class="lead rise" style="--d:2">Tu compañía es nuestro mejor regalo. Si quieres tener un detalle para Axel, aquí están nuestras mesas.</p>
  <div class="gifts rise" style="--d:3">
    <a class="btn big" href="https://mesaderegalos.liverpool.com.mx/milistaderegalos/60043188" target="_blank" rel="noopener">Ver mesa en Liverpool</a>
    <a class="btn big alt" href="https://www.amazon.com.mx/baby-reg/dafne-zamora-noviembre-2026-elmarques/2SCROPQPG8FA0" target="_blank" rel="noopener">Ver mesa en Amazon</a>
  </div>
  <h2 class="script rise" style="--d:4;margin-top:11cqw">Confirma tu asistencia</h2>
  <div class="card form rise" style="--d:5">
    <p class="pase">Tu invitación es para {pases} {pases === 1 ? 'persona' : 'personas'}</p>
    <form id="rsvp" novalidate>
      <fieldset class="choice">
        <legend class="sr">¿Asistirás?</legend>
        <label class="chip"><input type="radio" name="asiste" value="si" checked><span>Sí, ahí estaré</span></label>
        <label class="chip"><input type="radio" name="asiste" value="no"><span>No podré ir</span></label>
      </fieldset>
      <label class="f" for="nombre">Tu nombre</label>
      <input id="nombre" type="text" autocomplete="name" placeholder="Nombre y apellido">
      {pases > 1 && (
      <div id="personasField">
        <label class="f" for="personas">Personas que asisten (contándote)</label>
        <select id="personas">
          {Array.from({ length: pases }, (_, i) => <option value={i + 1} selected={i + 1 === pases}>{i + 1}</option>)}
        </select>
        {Array.from({ length: pases - 1 }, (_, i) => (
        <div class="acomp">
          <label class="f" for={`acomp${i + 1}`}>Acompañante {i + 1}</label>
          <input id={`acomp${i + 1}`} type="text" autocomplete="off" placeholder="Nombre y apellido">
        </div>
        ))}
      </div>
      )}
      <label class="f" for="mensaje">Mensaje para Axel (opcional)</label>
      <textarea id="mensaje" rows="2" placeholder="Unas palabras para Axel"></textarea>
      <p class="err" id="err" role="alert" hidden>Escribe tu nombre para continuar.</p>
    </form>
    <div id="done" hidden>
      <p class="f">Listo, este es tu mensaje:</p>
      <textarea id="preview" rows="6" readonly></textarea>
      <button class="btn small" type="button" id="copyBtn">Copiar mensaje</button>
      <p class="note" id="doneNote"></p>
      <button class="lnk" type="button" id="editBtn">Editar mi respuesta</button>
    </div>
    <button class="btn big full" id="submitBtn" type="submit" form="rsvp">Confirmar asistencia</button>
    <a class="btn big full wa" data-to="alan" href="#" target="_blank" rel="noopener" hidden>Enviar a Alan</a>
    <a class="btn big full wa" data-to="chayito" href="#" target="_blank" rel="noopener" hidden>Enviar a Chayito</a>
  </div>
</div></div></section><section class="cq" id="gracias"><div class="art"><img class="i fx fx-drop  " style="--x:0.000;--w:100.000;--y:0.000;--d:0" src="/dino/img/a1.webp" alt="" width="1194" height="504" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:55.611;--w:6.533;--y:33.082;--d:1" src="/dino/img/a4.webp" alt="" width="78" height="72" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:28.978;--w:8.794;--y:36.432;--d:1" src="/dino/img/a5.webp" alt="" width="105" height="99" loading="lazy" decoding="async"><img class="i fx fx-l  " style="--x:0.000;--w:18.509;--y:37.102;--d:2" src="/dino/img/a6.webp" alt="" width="221" height="173" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:64.070;--w:11.307;--y:40.117;--d:2" src="/dino/img/a7.webp" alt="" width="135" height="139" loading="lazy" decoding="async"><img class="i fx fx-r float sway " style="--x:77.638;--w:22.362;--y:40.117;--d:3" src="/dino/img/a8.webp" alt="" width="267" height="648" loading="lazy" decoding="async"><img class="i fx fx-zoom  " style="--x:23.869;--w:4.690;--y:46.147;--d:3" src="/dino/img/a13.webp" alt="" width="56" height="58" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:31.993;--w:5.444;--y:47.320;--d:4" src="/dino/img/a16.webp" alt="" width="65" height="38" loading="lazy" decoding="async"><img class="i fx fx-zoom  " style="--x:24.623;--w:3.853;--y:50.335;--d:4" src="/dino/img/a24.webp" alt="" width="46" height="51" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:31.575;--w:6.784;--y:51.256;--d:5" src="/dino/img/a27.webp" alt="" width="81" height="53" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:67.420;--w:9.129;--y:54.858;--d:5" src="/dino/img/a32.webp" alt="" width="109" height="91" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:9.966;--w:10.134;--y:56.616;--d:6" src="/dino/img/a33.webp" alt="" width="121" height="94" loading="lazy" decoding="async"><img class="i fx fx-l  " style="--x:0.000;--w:6.030;--y:63.735;--d:6" src="/dino/img/a37.webp" alt="" width="72" height="111" loading="lazy" decoding="async"><img class="i fx fx-l  " style="--x:0.000;--w:10.888;--y:71.859;--d:7" src="/dino/img/a48.webp" alt="" width="130" height="177" loading="lazy" decoding="async"><img class="i fx fx-r  " style="--x:83.501;--w:3.518;--y:83.668;--d:7" src="/dino/img/a71.webp" alt="" width="42" height="71" loading="lazy" decoding="async"><img class="i fx fx-zoom  " style="--x:21.106;--w:3.434;--y:85.511;--d:8" src="/dino/img/a74.webp" alt="" width="41" height="45" loading="lazy" decoding="async"><img class="i fx fx-l  " style="--x:0.000;--w:11.390;--y:87.856;--d:8" src="/dino/img/a76.webp" alt="" width="136" height="238" loading="lazy" decoding="async"><img class="i fx fx-l  " style="--x:12.982;--w:5.109;--y:88.275;--d:9" src="/dino/img/a78.webp" alt="" width="61" height="60" loading="lazy" decoding="async"><img class="i fx fx-zoom  " style="--x:77.889;--w:22.111;--y:92.127;--d:9" src="/dino/img/a79.webp" alt="" width="264" height="500" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:13.400;--w:7.873;--y:94.389;--d:9" src="/dino/img/a80.webp" alt="" width="94" height="91" loading="lazy" decoding="async"><img class="i fx fx-r  " style="--x:80.235;--w:6.700;--y:100.419;--d:9" src="/dino/img/a83.webp" alt="" width="80" height="82" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:16.750;--w:6.784;--y:103.769;--d:9" src="/dino/img/a84.webp" alt="" width="81" height="80" loading="lazy" decoding="async"><img class="i fx fx-zoom  " style="--x:0.000;--w:28.141;--y:104.858;--d:9" src="/dino/img/a85.webp" alt="" width="336" height="348" loading="lazy" decoding="async"><img class="i fx fx-zoom tw " style="--x:77.554;--w:7.035;--y:108.375;--d:9" src="/dino/img/a86.webp" alt="" width="84" height="83" loading="lazy" decoding="async"><img class="i fx fx-up  " style="--x:65.578;--w:13.987;--y:118.593;--d:9" src="/dino/img/a87.webp" alt="" width="167" height="184" loading="lazy" decoding="async"><img class="i fx fx-up  " style="--x:32.663;--w:40.034;--y:119.347;--d:9" src="/dino/img/a88.webp" alt="" width="478" height="175" loading="lazy" decoding="async"><img class="i fx fx-up  " style="--x:25.963;--w:9.045;--y:121.106;--d:9" src="/dino/img/a89.webp" alt="" width="108" height="154" loading="lazy" decoding="async"><img class="i fx fx-pop float " style="--x:17.337;--w:69.933;--y:40.955;--d:3" src="/dino/img/b_center.webp" alt="Dinosaurio bebé verde con babero y un triceratops azul" width="835" height="681" loading="lazy" decoding="async"><img class="i fx fx-up  " style="--x:24.037;--w:51.843;--y:99.162;--d:6" src="/dino/img/a82.webp" alt="" width="619" height="216" loading="lazy" decoding="async"><p class="t signtxt rise" data-fit="40.6" style="--d:7">¡Te esperamos!</p></div></section>
</main>

<script is:inline>
/* Datos del evento: aquí se cambian fecha, lugar y mapa */
var CONFIG = {
  fecha: "Sábado 28 de noviembre",        // ej. "Sábado 14 de noviembre"
  hora: "3:00 p.m.",         // ej. "2:00 p.m."
  lugar: "Iris 31, Fraccionamiento Zizana, Zakia",        // ej. "Salón Danny"
  direccion: "Preguntar por la casa club",    // ej. "San Agustín #12, col. La Florida, Querétaro"
  mapa: "https://maps.app.goo.gl/oALJGdZzApViENtn9",         // link de Google Maps
  inicio: "2026-11-29T14:00:00-06:00",       // para la cuenta regresiva, ej. "2026-11-14T14:00:00-06:00" (hora de CDMX)
  whatsapp: { chayito: "524421811432", alan: "524423977484" }   // números con lada de país, solo dígitos (ej. 52XXXXXXXXXX)
};

(function () {
  var $ = function (id) { return document.getElementById(id); };

  /* Datos */
  if (CONFIG.fecha) $('vFecha').textContent = CONFIG.fecha;
  if (CONFIG.hora) $('vHora').textContent = CONFIG.hora;
  if (CONFIG.lugar) $('vLugar').textContent = CONFIG.lugar;
  if (CONFIG.direccion) $('vDir').textContent = CONFIG.direccion;
  if (CONFIG.mapa) { $('mapBtn').href = CONFIG.mapa; $('mapBtn').hidden = false; }

  /* Ajusta el texto de la portada al ancho del diseño */
  function fit() {
    document.querySelectorAll('[data-fit]').forEach(function (el) {
      var cq = el.closest('.cq'); if (!cq) return;
      var unit = cq.clientWidth / 100; if (!unit) return;
      var w = el.getBoundingClientRect().width; if (!w) return;
      var cur = parseFloat(getComputedStyle(el).fontSize) / unit;
      el.style.fontSize = (cur * (parseFloat(el.dataset.fit) * unit) / w).toFixed(3) + 'cqw';
    });
  }
  fit();
  window.addEventListener('load', fit);
  if (document.fonts) {
    if (document.fonts.ready) document.fonts.ready.then(fit);
    if (document.fonts.addEventListener) document.fonts.addEventListener('loadingdone', fit);
  }

  /* Entrada suave de cada hoja */
  var arts = document.querySelectorAll('.cq');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { threshold: 0.2, rootMargin: '0px 0px -6% 0px' });
    arts.forEach(function (a) { io.observe(a); });
  } else {
    arts.forEach(function (a) { a.classList.add('in'); });
  }
  requestAnimationFrame(function () { arts[0].classList.add('in'); });

  /* Cuenta regresiva en vivo */
  var EVENT_TS = CONFIG.inicio ? new Date(CONFIG.inicio).getTime() : NaN;
  var cd = { d: $('cdD'), h: $('cdH'), m: $('cdM'), s: $('cdS'), head: $('cdHead') };
  function pad(n) { return n < 10 ? '0' + n : String(n); }
  function tick() {
    var diff = EVENT_TS - Date.now();
    if (diff <= 0) {
      cd.d.textContent = cd.h.textContent = cd.m.textContent = cd.s.textContent = '00';
      cd.head.innerHTML = -diff < 6 * 3600 * 1000 ? '¡Hoy es el gran día!<br>Axel Damián ya viene' : 'Gracias por acompañarnos<br>a recibir a Axel Damián';
      return;
    }
    var s = Math.floor(diff / 1000);
    cd.d.textContent = pad(Math.floor(s / 86400));
    cd.h.textContent = pad(Math.floor(s % 86400 / 3600));
    cd.m.textContent = pad(Math.floor(s % 3600 / 60));
    cd.s.textContent = pad(s % 60);
  }
  if (isNaN(EVENT_TS)) {
    $('cdRow').hidden = true; cd.head.textContent = 'Muy pronto te compartimos la fecha';
  } else { tick(); setInterval(tick, 1000); }

  /* Copiar con respaldo */
  function copyText(text, fallbackEl, btn) {
    var label = btn.textContent;
    function ok() { btn.textContent = 'Copiado'; setTimeout(function () { btn.textContent = label; }, 1800); }
    function fallback() { try { fallbackEl.focus(); fallbackEl.select(); if (document.execCommand('copy')) ok(); } catch (e) {} }
    try { navigator.clipboard.writeText(text).then(ok, fallback); } catch (e) { fallback(); }
  }

  /* Confirmación de asistencia */
  var form = $('rsvp'), done = $('done'), preview = $('preview'), sub = $('submitBtn'), wa = document.querySelectorAll('.wa');
  function asiste() { return form.elements['asiste'].value; }
  var pf = $('personasField'); // no existe en la invitación personal
  var acomps = [].slice.call(document.querySelectorAll('.acomp'));
  function sync() {
    if (!pf) return;
    pf.hidden = asiste() === 'no';
    var n = parseInt($('personas').value, 10);
    acomps.forEach(function (a, i) { a.hidden = i >= n - 1; });
  }
  form.addEventListener('change', sync);
  sync();
  function fail(el, text) { $('err').textContent = text; $('err').hidden = false; el.focus(); }
  function prepare(ev) {
    if (ev) ev.preventDefault();
    var nombre = $('nombre').value.trim();
    if (!nombre) return fail($('nombre'), 'Escribe tu nombre para continuar.');
    var n = pf ? parseInt($('personas').value, 10) : 1, msg = $('mensaje').value.trim(), t, nombres = [];
    if (asiste() === 'si') {
      for (var i = 0; i < n - 1; i++) {
        var inp = acomps[i].querySelector('input'), v = inp.value.trim();
        if (!v) return fail(inp, 'Escribe el nombre de cada acompañante.');
        nombres.push(v);
      }
    }
    $('err').hidden = true;
    var cuando = ' el ' + CONFIG.fecha.toLowerCase() + ' a las ' + CONFIG.hora;
    if (asiste() === 'si') {
      t = '¡Hola! Soy ' + nombre + '. Confirmo mi asistencia al baby shower de Axel Damián' + cuando + ' para ' + n + (n === 1 ? ' persona.' : ' personas.');
      if (nombres.length) t += ' Me acompaña' + (nombres.length > 1 ? 'n: ' : ': ') + nombres.join(', ') + '.';
    } else {
      t = '¡Hola! Soy ' + nombre + '. Gracias por la invitación al baby shower de Axel Damián. Lamentablemente no podré asistir, pero les mando un abrazo.';
    }
    if (msg) t += ' ' + msg;
    preview.value = t;
    wa.forEach(function (a) { a.href = 'https://wa.me/' + CONFIG.whatsapp[a.dataset.to] + '?text=' + encodeURIComponent(t); a.hidden = false; });
    $('doneNote').textContent = 'Toca el botón de Alan o Chayito y se abre WhatsApp con tu mensaje listo.';
    form.hidden = true; done.hidden = false; sub.hidden = true;
  }
  form.addEventListener('submit', prepare);
  $('copyBtn').addEventListener('click', function () { copyText(preview.value, preview, this); });
  $('editBtn').addEventListener('click', function () { done.hidden = true; form.hidden = false; wa.forEach(function (a) { a.hidden = true; }); sub.hidden = false; });
})();
</script>
