e="--x:0.000;--w:10.888;--y:71.859;--d:7" src="/dino/img/a48.webp" alt="" width="130" height="177" decoding="async"><img class="i fx fx-r  " style="--x:83.501;--w:3.518;--y:83.668;--d:7" src="/dino/img/a71.webp" alt="" width="42" height="71" decoding="async"><img class="i fx fx-zoom  " style="--x:21.106;--w:3.434;--y:85.511;--d:8" src="/dino/img/a74.webp" alt="" width="41" height="45" decoding="async"><img class="i fx fx-l  " style="--x:0.000;--w:11.390;--y:87.856;--d:8" src="/dino/img/a76.webp" alt="" width="136" height="238" decoding="async"><img class="i fx fx-l  " style="--x:12.982;--w:5.109;--y:88.275;--d:9" src="/dino/img/a78.webp" alt="" width="61" height="60" decoding="async"><img class="i fx fx-zoom  " style="--x:77.889;--w:22.111;--y:92.127;--d:9" src="/dino/img/a79.webp" alt="" width="264" height="500" decoding="async"><img class="i fx fx-zoom tw " style="--x:13.400;--w:7.873;--y:94.389;--d:9" src="/dino/img/a80.webp" alt="" width="94" height="91" decoding="async"><img class="i fx fx-r  " style="--x:80.235;--w:6.700;--y:100.419;--d:9" src="/dino/img/a83.webp" alt="" width="80" height="82" decoding="async"><img class="i fx fx-zoom tw " style="--x:16.750;--w:6.784;--y:103.769;--d:9" src="/dino/img/a84.webp" alt="" width="81" height="80" decoding="async"><img class="i fx fx-zoom  " style="--x:0.000;--w:28.141;--y:104.858;--d:9" src="/dino/img/a85.webp" alt="" width="336" height="348" decoding="async"><img class="i fx fx-zoom tw " style="--x:77.554;--w:7.035;--y:108.375;--d:9" src="/dino/img/a86.webp" alt="" width="84" height="83" decoding="async"><img class="i fx fx-up  " style="--x:65.578;--w:13.987;--y:118.593;--d:9" src="/dino/img/a87.webp" alt="" width="167" height="184" decoding="async"><img class="i fx fx-up  " style="--x:32.663;--w:40.034;--y:119.347;--d:9" src="/dino/img/a88.webp" alt="" width="478" height="175" decoding="async"><img class="i fx fx-up  " style="--x:25.963;--w:9.045;--y:121.106;--d:9" src="/dino/img/a89.webp" alt="" width="108" height="154" decoding="async"><img class="i fx fx-pop float " style="--x:15.829;--w:71.441;--y:40.536;--d:3" src="/dino/img/a9.webp" fetchpriority="high" alt="Dinosaurio bebé verde con babero y un triceratops azul" width="853" height="686" decoding="async"><img class="i fx fx-up  " style="--x:24.037;--w:51.843;--y:99.162;--d:6" src="/dino/img/a82.webp" alt="" width="619" height="216" decoding="async"><h1 class="t title rise" data-fit="69.1" style="--d:1">¡Mi Baby Shower!</h1><p class="t signtxt rise" data-fit="42.7" style="--d:7">¡Ya casi llega nuestro<br>pequeño dinosaurio!<br>¡Acompáñanos a celebrar!</p></div></section><section class="cq" id="datos"><div class="art flow"><img class="i fx fx-drop  " style="--x:0.000;--w:100.000;--y:0.000;--d:0" src="/dino/img/a1.webp" alt="" width="1194" height="504" loading="lazy" decoding="async"><img class="i fx fx-l  " style="--x:0.000;--w:18.509;--y:37.102;--d:1" src="/dino/img/a6.webp" alt="" width="221" height="173" loading="lazy" decoding="async"><img class="i bot fx fx-l  " style="--x:0.000;--w:6.030;--b:60.972;--d:1" src="/dino/img/a37.webp" alt="" width="72" height="111" loading="lazy" decoding="async"><img class="i bot fx fx-l  " style="--x:0.000;--w:10.888;--b:47.320;--d:2" src="/dino/img/a48.webp" alt="" width="130" height="177" loading="lazy" decoding="async"><img class="i bot fx fx-r  " style="--x:83.501;--w:3.518;--b:44.389;--d:2" src="/dino/img/a71.webp" alt="" width="42" height="71" loading="lazy" decoding="async"><img class="i bot fx fx-l  " style="--x:0.000;--w:11.390;--b:26.214;--d:3" src="/dino/img/a76.webp" alt="" width="136" height="238" loading="lazy" decoding="async"><img class="i bot fx fx-l  " style="--x:12.982;--w:5.109;--b:40.704;--d:3" src="/dino/img/a78.webp" alt="" width="61" height="60" loading="lazy" decoding="async"><img class="i bot fx fx-up  " style="--x:65.578;--w:13.987;--b:0.000;--d:4" src="/dino/img/a87.webp" alt="" width="167" height="184" loading="lazy" decoding="async"><img class="i bot fx fx-up  " style="--x:32.663;--w:40.034;--b:0.000;--d:4" src="/dino/img/a88.webp" alt="" width="478" height="175" loading="lazy" decoding="async"><img class="i bot fx fx-up  " style="--x:25.963;--w:9.045;--b:0.000;--d:5" src="/dino/img/a89.webp" alt="" width="108" height="154" loading="lazy" decoding="async">
<div class="content">
  <h2 class="script rise" style="--d:1">Te esperamos</h2>
