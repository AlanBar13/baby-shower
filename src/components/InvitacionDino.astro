---
const { pases } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Baby Shower del pequeño dinosaurio</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Nunito:wght@600;700;800&display=swap">
<style is:global>
/* Concepto: la invitación (acuarela de dinosaurios) como una sola hoja continua.
   Las ilustraciones son capas transparentes extraídas del diseño; el texto es real y aparece al llegar con el scroll. */
:root {
  --crema: #fefcf7;
  --pagina: #eef0e4;
  --cafe: #6b4429;
  --cafe-texto: #5a3d2b;
  --verde: #86ad74;
  --verde-osc: #6f9a5e;
  --azul: #7aa3cf;
  --madera: #e7cba0;
  --f-script: 'Kaushan Script', 'Brush Script MT', cursive;
  --f-sans: 'Nunito', 'Avenir Next', 'Segoe UI', system-ui, sans-serif;
}
html { color-scheme: light; scroll-behavior: smooth; }
body { background: var(--pagina); color: var(--cafe-texto); font-family: var(--f-sans); -webkit-text-size-adjust: 100%; margin: 0; }
* { box-sizing: border-box; }
h1, h2, p { margin: 0; font-weight: inherit; }
img { max-width: none; }
[hidden] { display: none !important; }

main { max-width: 560px; margin: 0 auto; background: var(--crema); box-shadow: 0 0 40px rgba(80, 100, 60, .14); }
.cq { container-type: inline-size; position: relative; width: 100%; overflow: hidden; }
.cq + .cq { margin-top: -6%; }
.art { position: relative; width: 100%; height: calc(134.0034cqw); overflow: hidden;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 7cqw, #000 calc(100% - 7cqw), transparent 100%);
          mask-image: linear-gradient(to bottom, transparent 0, #000 7cqw, #000 calc(100% - 7cqw), transparent 100%); }
.art.flow { height: auto; min-height: calc(134.0034cqw); }
#portada .art { -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 7cqw), transparent 100%); mask-image: linear-gradient(to bottom, #000 calc(100% - 7cqw), transparent 100%); }
#gracias .art { -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 7cqw); mask-image: linear-gradient(to bottom, transparent 0, #000 7cqw); }

.i { position: absolute; left: calc(var(--x) * 1cqw); top: calc(var(--y) * 1cqw); width: calc(var(--w) * 1cqw); height: auto; pointer-events: none; user-select: none; -webkit-user-drag: none; }
.i.bot { top: auto; bottom: calc(var(--b) * 1cqw); }

/* Texto de la portada */
.t { position: absolute; left: 50%; transform: translateX(-50%); white-space: nowrap; margin: 0; text-align: center; z-index: 2; }
.title { top: 28.06cqw; margin-top: -.55em; font: 400 10cqw/1.1 var(--f-script); color: var(--cafe); }
.signtxt { top: 108.2cqw; transform: translate(-50%, -50%); font: 600 3.4cqw/1.28 var(--f-sans); color: var(--cafe-texto); }

/* Contenido de las hojas intermedias */
.content { position: relative; z-index: 2; padding: 33cqw 9cqw 30cqw; text-align: center; }
.script { font: 400 10.5cqw/1.15 var(--f-script); color: var(--cafe); }
.lead { font: 600 4.2cqw/1.45 var(--f-sans); margin: 3cqw 3cqw 7cqw; color: var(--cafe-texto); }
.card { background: rgba(255, 254, 250, .86); border-radius: 5cqw; padding: 6cqw 5cqw 6.4cqw; outline: .35cqw dashed #cbb48c; outline-offset: -1.8cqw; box-shadow: 0 1.2cqw 3.4cqw rgba(110, 90, 50, .12); }
.card hr { border: 0; border-top: .3cqw dashed #d8c7a5; margin: 5cqw 8cqw; }
.lab { font: 800 3cqw/1 var(--f-sans); letter-spacing: .16em; text-transform: uppercase; color: var(--verde-osc); margin-bottom: 2.4cqw; }
.big { font: 400 7.6cqw/1.2 var(--f-script); color: var(--cafe); }
.big.sm { font-size: 6.6cqw; }
.mid { font: 700 4cqw/1.4 var(--f-sans); margin-top: 1.4cqw; }
.mid:empty { display: none; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 2cqw; min-height: 9.6cqw; padding: 0 7cqw; margin-top: 5cqw; border: 0; border-radius: 99cqw; text-decoration: none; cursor: pointer;
  background: linear-gradient(#93b980, var(--verde-osc)); color: #fff; font: 800 4cqw/1 var(--f-sans); box-shadow: 0 1cqw 2.4cqw rgba(80, 120, 60, .28); transition: transform .2s, filter .2s; }
.btn:hover { transform: translateY(-.3cqw); filter: brightness(1.05); }
.btn.big { min-height: 12cqw; padding: 0 9cqw; font-size: 4.4cqw; white-space: nowrap; }
.btn.alt { background: linear-gradient(#8fb4dc, #6d94c2); box-shadow: 0 1cqw 2.4cqw rgba(70, 100, 150, .26); }
.btn.small { min-height: 8cqw; font-size: 3.5cqw; padding: 0 6cqw; }
.btn.full { width: 100%; }
.gifts { display: flex; flex-direction: column; align-items: center; gap: 1cqw; }

.cd { margin-top: 10cqw; }
.cd-h { font: 400 6cqw/1.25 var(--f-script); color: var(--cafe); }
.cd-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2cqw; margin-top: 6cqw; }
.cd-c { background: rgba(255, 255, 255, .8); border: .35cqw solid #cfe0c6; border-radius: 3.4cqw; padding: 2.6cqw 0 2.2cqw; display: flex; flex-direction: column; align-items: center; gap: .8cqw; box-shadow: 0 .8cqw 2cqw rgba(100, 130, 80, .12); }
.cd-c b { font: 800 8.4cqw/1 var(--f-sans); color: var(--cafe); font-variant-numeric: tabular-nums; }
.cd-c small { font: 800 2.9cqw/1 var(--f-sans); color: var(--verde-osc); letter-spacing: .06em; text-transform: uppercase; }

/* Confirmación */
.card.form { text-align: left; }
.pase { text-align: center; font: 800 3.6cqw/1.2 var(--f-sans); color: var(--verde-osc); margin: 0 0 3cqw; }
.f { display: block; font: 800 3.3cqw/1.2 var(--f-sans); color: var(--cafe-texto); margin: 3cqw 0 1cqw; }
.card input[type=text], .card select, .card textarea { width: 100%; font: 700 max(16px, 3.8cqw)/1.3 var(--f-sans); color: var(--cafe-texto); background: #fff; border: .35cqw solid #d8c9a8; border-radius: 3cqw; padding: 2.4cqw 3cqw; }
.card textarea { resize: none; display: block; }
.card input::placeholder, .card textarea::placeholder { color: #a99b84; }
.choice { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2.4cqw; }
.chip { display: block; position: relative; }
.chip input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.chip span { display: block; text-align: center; padding: 3cqw 1cqw; border-radius: 3cqw; background: #fff; border: .35cqw solid #d8c9a8; font: 800 3.5cqw/1.1 var(--f-sans); color: var(--cafe-texto); }
.chip input:checked + span { background: var(--verde); border-color: var(--verde); color: #fff; }
.chip input:focus-visible + span, .card input:focus-visible, .card select:focus-visible, .card textarea:focus-visible, .btn:focus-visible, .lnk:focus-visible { outline: .8cqw solid #e2a35f; outline-offset: .4cqw; }
.err { color: #9a3b26; font: 800 3.2cqw/1.2 var(--f-sans); margin-top: 2cqw; }
.note { font: 700 3.1cqw/1.3 var(--f-sans); margin-top: 2cqw; }
#preview { font-size: max(16px, 3.4cqw); line-height: 1.3; }
.lnk { background: none; border: 0; padding: 1.5cqw 0 0; font: 800 3.3cqw var(--f-sans); color: var(--azul); text-decoration: underline; cursor: pointer; display: block; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Movimiento: cada parte aparece al llegar con el scroll */
.anim .rise { opacity: 0; translate: 0 2.6cqw; transition: opacity .9s ease, translate 1s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--d, 0) * 120ms); }
.anim .in .rise { opacity: 1; translate: 0 0; }
.anim .fx { opacity: 0; transition: opacity 1s ease, translate 1.1s cubic-bezier(.2, .7, .2, 1), scale 1.1s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--d, 0) * 110ms); }
.anim .fx-up { translate: 0 5cqw; }
.anim .fx-drop { translate: 0 -6cqw; }
.anim .fx-l { translate: -9cqw 0; }
.anim .fx-r { translate: 9cqw 0; }
.anim .fx-zoom { scale: .9; }
.anim .fx-pop { translate: 0 7cqw; scale: .84; transition-duration: 1.25s; }
.anim .in .fx { opacity: 1; translate: 0 0; scale: 1; }
.float { animation: bob 6s ease-in-out infinite; }
.float.sway { animation: sway 7s ease-in-out infinite; transform-origin: 50% 85%; }
.tw { animation: tw 4.5s ease-in-out infinite; }
.tw:nth-of-type(odd) { animation-delay: -1.8s; }
.tw:nth-of-type(3n) { animation-delay: -3.1s; }
@keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-1.1cqw); } }
@keyframes sway { 0%, 100% { transform: rotate(-1.2deg); } 50% { transform: rotate(1.2deg) translateY(-.5cqw); } }
@keyframes tw { 0%, 100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-1.4cqw) rotate(3deg); } }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .float, .tw { animation: none; } }
</style>

<script is:inline>if ("IntersectionObserver" in window && !(window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches)) document.documentElement.classList.add("anim");</script>
</head>
<body>
<main data-pases={pases}>
